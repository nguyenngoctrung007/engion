{
  "name": "engion-tray-learner",
  "private": true,
  "version": "1.1.1",
  "description": "Engion - Application for English Vocabulary Passive Learning",
  "author": "Engion Team",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "node scripts/create-icon.js",
    "dev": "node scripts/create-icon.js && vite",
    "build": "node scripts/create-icon.js && tsc && vite build",
    "dist": "npm run build && npx electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.engion.app",
    "productName": "Engion",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "nguyenngoctrung007",
      "repo": "engion"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^17.4.2",
    "electron": "^31.2.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.5",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
