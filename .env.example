# Google OAuth2 Credentials — required for the Google Drive Sync feature.
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth Client ID of type "Desktop app", then enable the Google Drive API
# and add the `.../auth/drive.appdata` scope on the OAuth consent screen.
# Copy this file to `.env` and fill in your own values — `.env` is gitignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
